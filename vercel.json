{
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/(.*)",
        "destination": "/icp-maintenance.html"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
