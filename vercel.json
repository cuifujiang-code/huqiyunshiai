{
  "functions": {
    "api/generate-exam.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/planning/generate.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,knowledge-base/**}"
    },
    "api/diagnosis/generate.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/@alicloud/pop-core/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/diagnosis/submit.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/diagnosis/status.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/diagnosis/job.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/diagnosis/run-ocr.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/@alicloud/pop-core/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/diagnosis/run-analysis.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/diagnosis/process.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/@alicloud/pop-core/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/diagnosis/process-ocr.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/@alicloud/pop-core/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/diagnosis/process-analysis.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/teacher/decompose-submit.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/teacher/decompose-process.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/teacher/decompose-status.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/teacher/decompose-tasks.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/teacher/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/batch/upload.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**,node_modules/adm-zip/**}"
    },
    "api/batch/start.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/progress.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/worker.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**,node_modules/adm-zip/**}"
    },
    "api/batch/health.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/auto-retry.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.huqiyunshiai.online https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
