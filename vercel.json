{
  "redirects": [
    {
      "source": "/((?!icp-maintenance\\.html).*)",
      "destination": "/icp-maintenance.html",
      "statusCode": 307
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
