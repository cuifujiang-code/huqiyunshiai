# 教师端独立 API（默认 https://api.huqiyunshiai.online，可按需覆盖）
VITE_TEACHER_API_URL=https://api.huqiyunshiai.online
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=
# 大批量拆题系统（需执行 supabase/migrations/007_batch_decompose_system.sql）
# DEEPSEEK_BATCH_MODEL=deepseek-v4-flash
# VITE_BATCH_USE_TEACHER_API=true   # 默认走同源 /api/batch，设为 true 才走独立 teacher-api
# BATCH_WORKER_SECRET=          # 可选，保护 /api/batch/worker 回调
# BATCH_WORKER_PATH=/api/batch/worker   # 独立 teacher-api 必须使用 /api/batch/worker
# BATCH_AI_CONCURRENCY=5        # 每轮 AI 并发数
# BATCH_ITEMS_PER_RUN=8         # 每轮 worker 处理分块数
# 阿里云 OCR 手写体识别（endpoint 已在代码中硬编码为杭州，无需配置 ALIBABA_OCR_ENDPOINT）
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
# 异步诊断任务（需在 Supabase 执行 supabase/migrations/002_create_diagnosis_tasks.sql）
# 教师端工具链（需执行 supabase/migrations/005_teacher_tools.sql）
# DIAGNOSIS_PROCESS_SECRET=  # 可选，保护 /api/diagnosis/process 回调
PORT=
