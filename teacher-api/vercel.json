{
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/[...path].js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/ai/orchestrate.js": {
      "maxDuration": 300,
      "includeFiles": "server/**"
    },
    "api/student/photo-search.js": {
      "maxDuration": 300,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
