{
  "functions": {
    "api/teacher/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/decompose-submit.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/decompose-process.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/decompose-status.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/decompose-tasks.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/upload.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/batch/start.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/progress.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/worker.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
