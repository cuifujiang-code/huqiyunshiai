{
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/teacher/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/batch/upload.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/batch/start.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/progress.js": {
      "maxDuration": 10,
      "includeFiles": "server/**"
    },
    "api/batch/health.js": {
      "maxDuration": 15,
      "includeFiles": "server/**"
    },
    "api/batch/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/batch/worker.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,node_modules/mammoth/**,node_modules/pdf-parse/**,node_modules/pdfjs-dist/**}"
    },
    "api/batch/auto-retry.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/batch/auto-retry",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api" }
  ]
}
