  "dynamic_calibration_rule": {
    "description": "根据学生当前成绩与目标院校录取线的差距，动态调整五阶段规划强度与时间节点",
    "calibration_interval_days": 30,
    "score_gap_bands": [
      {
        "band": "critical",
        "label": "差距极大（>80分或位次差距>50000）",
        "min_score_gap": 80,
        "strategy": "启动基础重建期，延长阶段1-2各4周，降低阶段5志愿冲刺前的预期，建议同步评估备选院校",
        "stage_intensity_multiplier": 1.3,
        "add_risk": "目标院校当前差距过大，需设置1-2所梯度备选院校"
      },
      {
        "band": "challenging",
        "label": "有挑战（40-80分或位次差距20000-50000）",
        "min_score_gap": 40,
        "max_score_gap": 80,
        "strategy": "强化阶段2-3专题突破，每周增加1套限时模拟，首考/一模后重新校准",
        "stage_intensity_multiplier": 1.15,
        "add_milestone": "每模考后更新分数差距并调整任务量"
      },
      {
        "band": "reachable",
        "label": "可达成（15-40分或位次差距5000-20000）",
        "min_score_gap": 15,
        "max_score_gap": 40,
        "strategy": "保持五阶段标准节奏，阶段4开始套卷冲刺，阶段5精准志愿填报",
        "stage_intensity_multiplier": 1.0
      },
      {
        "band": "comfortable",
        "label": "较稳妥（<15分或位次差距<5000）",
        "max_score_gap": 15,
        "strategy": "阶段4-5侧重稳定发挥与志愿梯度优化，防止大意失分",
        "stage_intensity_multiplier": 0.9,
        "add_task": "每日错题复盘+心态管理"
      }
    ],
    "trigger_events": [
      { "event": "模考结束", "action": "recalculate_score_gap", "within_days": 3 },
      { "event": "首考成绩公布", "action": "recalculate_score_gap_and_elective_strategy", "within_days": 5 },
      { "event": "省排名更新", "action": "recalibrate_volunteer_strategy", "within_days": 7 }
    ],
    "forbidden_when_recalibrating": [
      "不得凭空提高目标院校录取线",
      "不得删除已引用的数据来源",
      "不得在未录入新成绩时宣称「已提升XX分」"
    ]
  },

  "five_stage_framework": {
    "name": "华祺云师五阶段升学规划框架",
    "total_duration_months": 12,
    "stages": [
      {
        "stage": 1,
        "id": "diagnosis",
        "name": "诊断定位期",
        "duration_weeks": 4,
        "period_label": "第1-4周",
        "objectives": [
          "全面诊断当前各科得分率与位次",
          "明确与目标院校录取线的分数/位次差距",
          "建立错题本与知识漏洞清单"
        ],
        "core_tasks": [
          "完成近3次大考各科得分率分析",
          "对照目标院校录取数据计算差距",
          "制定各科优先级排序（投入产出比）"
        ],
        "deliverables": ["学情诊断报告", "目标差距量化表", "各科优先级清单"],
        "calibration_checkpoint": "首次模考后更新差距表"
      },
      {
        "stage": 2,
        "id": "foundation",
        "name": "基础巩固期",
        "duration_weeks": 8,
        "period_label": "第5-12周",
        "objectives": [
          "补齐基础题失分点，确保基础题得分率≥95%",
          "选考/薄弱学科建立专题突破计划",
          "形成稳定作息与复习节奏"
        ],
        "core_tasks": [
          "每周2套基础卷+错题归类",
          "选考科目专题训练（按知识模块）",
          "每日30分钟错题复盘"
        ],
        "deliverables": ["基础题得分率报告", "专题突破进度表"],
        "calibration_checkpoint": "期中/一模前进行基础达标验收"
      },
      {
        "stage": 3,
        "id": "breakthrough",
        "name": "专题突破期",
        "duration_weeks": 10,
        "period_label": "第13-22周",
        "objectives": [
          "攻克中档题与综合题",
          "选考科目冲等级（如浙江首考/等级赋分）",
          "缩小与目标线差距至40分以内"
        ],
        "core_tasks": [
          "每周1-2套中档综合卷限时训练",
          "选考科目限时专题（按高考题型）",
          "薄弱模块一对一/小组答疑"
        ],
        "deliverables": ["中档题正确率报告", "选考等级目标对照表"],
        "calibration_checkpoint": "首考/一模后动态校准阶段强度"
      },
      {
        "stage": 4,
        "id": "sprint",
        "name": "冲刺模拟期",
        "duration_weeks": 8,
        "period_label": "第23-30周",
        "objectives": [
          "高考真题/高质量模拟卷限时训练",
          "应试技巧与时间管理优化",
          "总分稳定在目标线附近"
        ],
        "core_tasks": [
          "每周2套全真限时模拟（含涂卡）",
          "各科答题模板与规范化解题",
          "心理调适与考前作息调整"
        ],
        "deliverables": ["模拟考成绩曲线", "应试策略清单"],
        "calibration_checkpoint": "二模/三模后调整志愿策略"
      },
      {
        "stage": 5,
        "id": "volunteer",
        "name": "志愿与录取期",
        "duration_weeks": 4,
        "period_label": "第31-34周（高考后）",
        "objectives": [
          "基于最终成绩与位次制定志愿方案",
          "冲稳保梯度合理，选科/专业匹配",
          "关注提前批、强基、综评等多元通道"
        ],
        "core_tasks": [
          "对照一分一段表锁定位次区间",
          "筛选专业+院校组合（符合选科）",
          "完成冲稳保志愿表并复核"
        ],
        "deliverables": ["志愿填报方案", "备选院校清单", "录取概率评估"],
        "calibration_checkpoint": "出分后24小时内更新志愿方案"
      }
    ]
  },

