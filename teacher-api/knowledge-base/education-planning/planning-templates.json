  "empty_data_rule": {
    "action": "warn_and_continue",
    "forbid_ai_hallucination": false,
    "forbid_fabricated_scores": true,
    "degraded_mode": true,
    "degraded_mode_message": "知识库中暂无该目标院校的精确录取数据，系统已切换至「层级估算模式」，基于同层级院校的录取区间生成参考规划。报告中涉及的分数线为区间估算值，非权威数据，请在正式志愿填报时以教育考试院公布数据为准。",
    "message": "知识库中暂无该目标院校/省份/专业的精确录取数据。系统已自动切换至层级估算模式，将基于同层级院校录取区间生成参考规划。如需精确数据，请：① 在目标院校列表中选择知识库已收录院校；② 联系管理员更新 planning-templates.json；③ 手动填写「特殊说明」中的目标分数参考。",
    "user_guidance": [
      "请确认院校名称是否为标准全称或常用简称（如「清华」「清华大学」）",
      "请确认省份与高考省份一致（如浙江考生选「浙江」）",
      "若目标专业不在库中，可尝试相近专业或选择「通用」",
      "您也可以直接选择院校层次（如「211/双一流」），系统将基于该层次的录取区间生成参考规划"
    ],
    "http_status": 200
  },

